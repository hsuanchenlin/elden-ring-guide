---
import Checklist from "../components/Checklist.svelte";
import Panel from "../components/Panel.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { flaskPickups, pickupQuantity, pickupsByKind, seedThresholds, totalQuantity } from "../data/flasks";
import { zones } from "../data/zones";

const seeds = pickupsByKind("golden-seed");
const tears = pickupsByKind("sacred-tear");
const zoneName = Object.fromEntries(zones.map((zone) => [zone.id, zone.name]));

function pickupMeta(pickup: (typeof flaskPickups)[number]): string {
  const parts = [zoneName[pickup.zone], pickup.location];
  const quantity = pickupQuantity(pickup);
  if (quantity > 1) parts.push(`${quantity} ${pickup.kind === "golden-seed" ? "seeds" : "tears"}`);
  return parts.join(" · ");
}

const seedGroups = [
  {
    heading: "",
    items: seeds.map((pickup) => ({
      id: pickup.id,
      title: pickup.name,
      detail: pickup.detail,
      optional: pickup.priority === "detour" || pickup.id === "seed-keepsake",
      meta: pickupMeta(pickup),
    })),
  },
];

const tearGroups = [
  {
    heading: "",
    items: tears.map((pickup) => ({
      id: pickup.id,
      title: pickup.name,
      detail: pickup.detail,
      optional: pickup.priority === "detour",
      meta: pickupMeta(pickup),
    })),
  },
];
---

<BaseLayout
  title="Flask Upgrades"
  description="Early Golden Seed and Sacred Tear locations through Leyndell, with a persistent checklist and flask charge table."
>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <p class="rune-title text-[11px] text-gold">Survival ledger</p>
    <h1 class="rune-title mt-3 text-3xl text-gold-bright sm:text-4xl">Flask Upgrades</h1>
    <p class="mt-4 max-w-3xl text-lg text-parchment-muted">
      Sacred Tears raise how much each sip heals. Golden Seeds raise how many sips you get. Phase 1 lists every tear
      before the Mountaintops and the seeds you can collect without leaving the Limgrave-to-Leyndell road.
    </p>

    <div class="mt-10 grid gap-4 md:grid-cols-3">
      <Panel class="flex h-full flex-col p-5">
        <p class="rune-title text-[10px] text-gold">Starting flask</p>
        <p class="mt-2 text-2xl text-gold-bright">4 charges</p>
        <p class="mt-2 text-sm text-parchment-muted">Split between crimson and cerulean however you like at a grace.</p>
      </Panel>
      <Panel class="flex h-full flex-col p-5">
        <p class="rune-title text-[10px] text-gold">First-hours target</p>
        <p class="mt-2 text-2xl text-gold-bright">7-8 charges, +3-4 potency</p>
        <p class="mt-2 text-sm text-parchment-muted">
          Stormhill, Fort Haight, the Weeping Peninsula loop, and the Third Church of Marika.
        </p>
      </Panel>
      <Panel class="flex h-full flex-col p-5">
        <p class="rune-title text-[10px] text-gold">Listed here</p>
        <p class="mt-2 text-2xl text-gold-bright">{flaskPickups.length} pickups</p>
        <p class="mt-2 text-sm text-parchment-muted">
          {totalQuantity(seeds)} seeds at {seeds.length} locations · {tears.length} tears through Leyndell.
        </p>
      </Panel>
    </div>

    <Panel class="mt-8 overflow-x-auto p-6">
      <h2 class="font-display text-2xl text-parchment">Seeds to flask charges</h2>
      <table class="mt-4 w-full min-w-[28rem] text-left text-sm">
        <thead class="rune-title text-[10px] text-parchment-faint">
          <tr>
            <th class="pb-2 font-normal">Flask charges</th>
            <th class="pb-2 font-normal">Seeds required (total)</th>
            <th class="pb-2 font-normal">Seeds for this step</th>
          </tr>
        </thead>
        <tbody>
          {
            seedThresholds.map((row, index) => {
              const previous = seedThresholds[index - 1];
              const step = previous ? row.totalSeeds - previous.totalSeeds : 0;
              return (
                <tr class="border-t border-gold/10">
                  <td class="py-2 text-gold-bright">{row.charges}</td>
                  <td class="py-2">{row.totalSeeds}</td>
                  <td class="py-2 text-parchment-muted">{step === 0 ? "start" : `+${step}`}</td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </Panel>

    <div class="mt-10 grid gap-8 lg:grid-cols-2">
      <Panel class="p-6">
        <h2 class="font-display text-2xl text-parchment">Golden Seeds</h2>
        <p class="mt-2 text-sm text-parchment-muted">Found at illusory saplings, and sometimes dropped by tree spirits.</p>
        <div class="mt-6">
          <Checklist client:load groups={seedGroups} />
        </div>
      </Panel>
      <Panel class="p-6">
        <h2 class="font-display text-2xl text-parchment">Sacred Tears</h2>
        <p class="mt-2 text-sm text-parchment-muted">
          Almost always on the altar of a church. The two Mountaintops churches are omitted until a later phase.
        </p>
        <div class="mt-6">
          <Checklist client:load groups={tearGroups} />
        </div>
      </Panel>
    </div>
  </div>
</BaseLayout>
