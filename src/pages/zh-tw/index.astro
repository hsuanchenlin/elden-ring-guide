---
import ErdtreeMark from "../../components/ErdtreeMark.astro";
import Panel from "../../components/Panel.astro";
import ProgressHud from "../../components/ProgressHud.svelte";
import VideoEmbed from "../../components/VideoEmbed.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { flaskPickups } from "../../data/flasks";
import { starterBuilds } from "../../data/builds";
import { allLandmarks, zones } from "../../data/zones";
import { challengeVideos } from "../../data/challenges";

const locale = "zh-tw";
const isZh = true;
const localePrefix = "/zh-tw";
const trackedIds = [...allLandmarks().map((item) => item.id), ...flaskPickups.map((item) => item.id)];

const t = {
  title: "The Tarnished Codex",
  tagline: "艾爾登法環 推薦路線",
  intro: "從寧姆格拉夫到羅德爾王城的推薦首周目路線。優先存活、升級聖杯、完成一個 builds。",
  orderTitle: "無牢籠的秩序",
  surviveTitle: "優先存活",
  buildTitle: "有意識地 builds",
  routeTitle: "五區域通往黃金樹",
  openRoute: "開啟路線",
  flaskTitle: "聖杯升級",
  flaskLink: "開啟聖杯記錄",
  buildLink: "開啟 archetypes",
  challengeTitle: "挑戰影片",
  challengeIntro: "精選真實可嵌入的 YouTube 挑戰影片（武器限定、無HP升級、無物品跑）。此為人工精選目錄，非即時搜尋。",
};
---

<BaseLayout title={t.title} locale={locale} description={t.intro}>
  <section class="relative overflow-hidden">
    <div class="mx-auto max-w-6xl px-4 pb-16 pt-16 sm:px-6 sm:pt-24">
      <div class="flex flex-col items-center text-center">
        <ErdtreeMark class="mb-6 h-20 w-20 text-gold" />
        <p class="rune-title text-[11px] text-gold">{t.tagline}</p>
        <h1 class="rune-title mt-4 text-3xl text-gold-bright sm:text-5xl">The Tarnished Codex</h1>
        <div class="gold-rule mx-auto mt-6 w-48"></div>
        <p class="mt-6 max-w-2xl text-lg text-parchment-muted">
          {t.intro}
        </p>
        <ProgressHud client:load ids={trackedIds} />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="grid gap-4 md:grid-cols-3">
      <Panel class="p-6">
        <p class="rune-title text-[10px] text-gold">01</p>
        <h2 class="mt-3 font-display text-xl text-parchment">{t.orderTitle}</h2>
        <p class="mt-3 text-parchment-muted">
          黃金樹之間不會告訴你該往哪走。本法典會：一個首周目路線，讓你活得夠久來學習遊戲。教會或洞穴拉你偏離時就繞道。
        </p>
      </Panel>
      <Panel class="p-6">
        <p class="rune-title text-[10px] text-gold">02</p>
        <h2 class="mt-3 font-display text-xl text-parchment">{t.surviveTitle}</h2>
        <p class="mt-3 text-parchment-muted">
          金種子與聖杯之淚的優先級高於你還沒準備好的武器。活力就是武器。許多褪色者因為把早期盧恩花在傷害上而倒下。
        </p>
      </Panel>
      <Panel class="p-6">
        <p class="rune-title text-[10px] text-gold">03</p>
        <h2 class="mt-3 font-display text-xl text-parchment">{t.buildTitle}</h2>
        <p class="mt-3 text-parchment-muted">
          完成一個初始 builds（流浪者力量、武士出血或星術師魔法）就能帶你通過王城。三個半成品 builds 不行。
        </p>
      </Panel>
    </div>
  </section>

  <section class="mx-auto mt-16 max-w-6xl px-4 sm:px-6">
    <div class="mb-6 flex items-end justify-between gap-4">
      <div>
        <p class="rune-title text-[11px] text-gold">Phase 1 路線</p>
        <h2 class="mt-2 font-display text-2xl text-parchment">{t.routeTitle}</h2>
      </div>
      <a href={`${localePrefix}/progression`} class="rune-title text-[11px] text-gold hover:text-gold-bright">{t.openRoute}</a>
    </div>
    <ol class="grid gap-3 md:grid-cols-5">
      {
        zones.map((zone) => (
          <li>
            <a
              href={`${localePrefix}/progression#${zone.id}`}
              class="panel relative flex h-full min-h-40 flex-col border border-gold/20 bg-obsidian-panel/90 p-4 transition-colors hover:border-gold"
              style={`border-top: 2px solid ${zone.accent}`}
            >
              <p class="rune-title text-[10px] text-gold">{String(zone.order).padStart(2, "0")}</p>
              <h3 class="mt-2 font-display text-lg text-parchment">{zone.shortName}</h3>
              <p class="mt-auto pt-3 text-xs text-parchment-faint">{zone.levelRange}</p>
              <p class="text-xs text-parchment-muted">{zone.weaponUpgrade}</p>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="mx-auto mt-16 grid max-w-6xl gap-4 px-4 sm:px-6 md:grid-cols-2">
    <Panel class="p-6">
      <p class="rune-title text-[11px] text-gold">Survival</p>
      <h2 class="mt-2 font-display text-2xl text-parchment">{t.flaskTitle}</h2>
      <p class="mt-3 text-parchment-muted">
        Early Golden Seeds and Sacred Tears through Leyndell, as a checklist that remembers what you have already pocketed.
      </p>
      <a href={`${localePrefix}/flasks`} class="rune-title mt-4 inline-block text-[11px] text-gold hover:text-gold-bright">
        {t.flaskLink}
      </a>
    </Panel>
    <Panel class="p-6">
      <p class="rune-title text-[11px] text-gold">Archetypes</p>
      <h2 class="mt-2 font-display text-2xl text-parchment">Starter builds</h2>
      <ul class="mt-3 space-y-1 text-parchment-muted">
        {starterBuilds.map((build) => <li>{build.className} - {build.archetype}</li>)}
      </ul>
      <a href={`${localePrefix}/builds`} class="rune-title mt-4 inline-block text-[11px] text-gold hover:text-gold-bright">
        {t.buildLink}
      </a>
    </Panel>
  </section>

  <section class="mx-auto mt-16 max-w-6xl px-4 sm:px-6">
    <div class="mb-6">
      <p class="rune-title text-[11px] text-gold">挑戰探索</p>
      <h2 class="mt-2 font-display text-2xl text-parchment">{t.challengeTitle}</h2>
      <p class="mt-3 max-w-2xl text-parchment-muted">{t.challengeIntro}</p>
      <p class="mt-1 text-xs text-parchment-faint">
        使用官方 trailer 嵌入 + 點擊載入隱私 facade。僅收錄可嵌入的真實影片。
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      {challengeVideos.map((video) => (
        <VideoEmbed
          youtubeId={video.youtubeId}
          title={video.title}
          note={`${video.runner} · ${video.published} · ${video.category}${video.note ? " · " + video.note : ""}`}
        />
      ))}
    </div>

    <p class="mt-4 text-xs text-parchment-faint">
      此為 Phase 1 人工精選目錄。後續階段可能自動化（需額外授權）。
    </p>
  </section>
</BaseLayout>
