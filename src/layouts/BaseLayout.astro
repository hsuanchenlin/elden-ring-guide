---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.svelte";
import "../styles/global.css";
import { isPublished, locales, pathFor, routeOf, type Locale } from "../lib/i18n";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "A recommended Elden Ring progression route through Limgrave, Liurnia, Caelid, Altus Plateau, and Leyndell, with flask upgrades and starter builds.",
} = Astro.props;
const pageTitle = title.includes("Tarnished Codex") ? title : `${title} · Tarnished Codex`;

const locale: Locale = Astro.currentLocale === "zh-tw" ? "zh-tw" : "en";
const route = routeOf(Astro.url.pathname);
const absoluteUrl = (path: string) => new URL(path, Astro.site).href;
const alternates = locales.filter((candidate) => isPublished(candidate, route));
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === "zh-tw" ? "zh_TW" : "en_US"} />
    <link rel="canonical" href={absoluteUrl(pathFor(locale, route))} />
    {
      alternates.length > 1 && (
        <>
          {alternates.map((alternate) => (
            <link rel="alternate" hreflang={alternate} href={absoluteUrl(pathFor(alternate, route))} />
          ))}
          <link rel="alternate" hreflang="x-default" href={absoluteUrl(pathFor("en", route))} />
        </>
      )
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body class="grain antialiased">
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-obsidian-panel focus:px-3 focus:py-2 focus:text-gold"
    >
      {locale === "zh-tw" ? "跳至內容" : "Skip to content"}
    </a>
    <Header client:load currentPath={Astro.url.pathname} currentLocale={locale} />
    <main id="content">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
