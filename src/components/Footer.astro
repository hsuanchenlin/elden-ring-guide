---
import type { Locale } from "../lib/i18n";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const year = new Date().getFullYear();
const copy =
  locale === "zh-tw"
    ? {
        route: "第一階段路線：寧姆格福、利耶尼亞、蓋利德、亞壇高原到王城羅德爾。是推薦路線，不是韁繩。",
        legal: `${year} · 非官方、非商業的玩家指南 · 艾爾登法環為 FromSoftware / Bandai Namco 所有 · 影片皆為原頻道的 YouTube 嵌入`,
      }
    : {
        route: "Phase 1 route: Limgrave through Liurnia, Caelid, Altus Plateau, and Leyndell. A recommended path, not a leash.",
        legal: `${year} · Unofficial, non-commercial fan guide · Elden Ring is FromSoftware / Bandai Namco · Videos are YouTube embeds from their original channels`,
      };
---

<footer class="mt-20 border-t border-gold/20 bg-obsidian-panel/60">
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-10 sm:px-6 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="rune-title text-xs text-gold">The Tarnished Codex</p>
      <p class="mt-2 max-w-xl text-sm text-parchment-muted">{copy.route}</p>
    </div>
    <p class="max-w-sm text-sm text-parchment-faint md:text-right">{copy.legal}</p>
  </div>
</footer>
