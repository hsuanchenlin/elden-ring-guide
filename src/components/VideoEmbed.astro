---
interface Props {
  youtubeId: string;
  title: string;
  /** Short tag shown on the tile, e.g. the run's constraint or "Official trailer". */
  label: string;
  /** Attribution line under the tile. */
  caption?: string;
  /** Verb for the play button's accessible name. */
  playLabel?: string;
}

const { youtubeId, title, label, caption, playLabel = "Play" } = Astro.props;
const embedSrc = `https://www.youtube-nocookie.com/embed/${youtubeId}?autoplay=1&rel=0`;
---

<div class="video-embed" data-embed-src={embedSrc} data-title={title}>
  <div class="relative aspect-video w-full overflow-hidden border border-gold/20 bg-obsidian-panel">
    <!-- Click-to-load facade: nothing is requested from YouTube until the visitor presses play. -->
    <button
      type="button"
      class="group absolute inset-0 flex items-center justify-center bg-[radial-gradient(ellipse_at_center,rgb(201_162_39/0.16),transparent_62%)] transition hover:bg-[radial-gradient(ellipse_at_center,rgb(201_162_39/0.26),transparent_62%)]"
      aria-label={`${playLabel}: ${title}`}
      data-play-button
    >
      <span class="rune-title absolute left-4 top-4 text-[10px] text-gold">{label}</span>
      <span
        class="flex h-16 w-16 items-center justify-center rounded-full border-2 border-gold/80 bg-obsidian/80 text-gold transition group-hover:scale-110 group-hover:border-gold"
      >
        <svg class="h-8 w-8" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M8 5v14l11-7z" />
        </svg>
      </span>
      <span class="rune-title absolute bottom-3 right-3 text-[9px] text-parchment-faint">YouTube</span>
    </button>

    <div class="hidden h-full w-full" data-iframe-container></div>
  </div>

  <p class="mt-3 text-parchment">{title}</p>
  {caption && <p class="mt-1 text-xs text-parchment-faint">{caption}</p>}
</div>

<script>
  function initVideoEmbeds() {
    document.querySelectorAll<HTMLElement>(".video-embed").forEach((container) => {
      const playBtn = container.querySelector<HTMLButtonElement>("[data-play-button]");
      const iframeContainer = container.querySelector<HTMLElement>("[data-iframe-container]");
      const src = container.dataset.embedSrc;
      if (!playBtn || !iframeContainer || !src) return;

      playBtn.addEventListener(
        "click",
        () => {
          const iframe = document.createElement("iframe");
          iframe.src = src;
          iframe.title = container.dataset.title || "YouTube video";
          iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
          iframe.allowFullscreen = true;
          iframe.className = "h-full w-full border-0";
          iframe.setAttribute("referrerpolicy", "strict-origin-when-cross-origin");

          iframeContainer.replaceChildren(iframe);
          iframeContainer.classList.remove("hidden");
          playBtn.classList.add("hidden");
        },
        { once: true }
      );
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initVideoEmbeds);
  } else {
    initVideoEmbeds();
  }
</script>
